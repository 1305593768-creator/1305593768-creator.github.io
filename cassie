<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>From User Expression to Community Growth | 周慧 Cassie</title>
  <meta name="description" content="周慧 Cassie 的无限暖暖内容生态观察、研究手账与营销策划作品集。">
  <style>
    :root {
      --bg: #fff3f8;
      --bg-2: #ffe7f0;
      --paper: rgba(255, 252, 255, .82);
      --paper-strong: rgba(255, 255, 255, .94);
      --pink: #f46fa2;
      --pink-2: #ffb4cf;
      --rose: #b84272;
      --rose-dark: #623042;
      --blue: #7ed7ff;
      --cyan: #8ff3f0;
      --violet: #b99cff;
      --ink: #2d2430;
      --muted: #705e68;
      --line: rgba(184, 66, 114, .18);
      --line-strong: rgba(184, 66, 114, .30);
      --shadow: 0 26px 80px -42px rgba(142, 42, 84, .58), 0 14px 42px -30px rgba(65, 73, 138, .46);
      --soft: 0 18px 44px -30px rgba(142, 42, 84, .52);
      --radius: 30px;
      --radius-sm: 18px;
      --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
      --serif: "Songti SC", "Noto Serif SC", Georgia, serif;
      color-scheme: light;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background: var(--bg); }
    body {
      margin: 0;
      min-width: 320px;
      color: var(--ink);
      font-family: var(--sans);
      line-height: 1.68;
      overflow-x: hidden;
      background:
        radial-gradient(circle at 12% 8%, rgba(255, 180, 207, .62), transparent 30%),
        radial-gradient(circle at 92% 0%, rgba(126, 215, 255, .40), transparent 28%),
        linear-gradient(180deg, #fff6fb 0%, #ffeaf3 42%, #fff7fb 100%);
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(184,66,114,.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(184,66,114,.045) 1px, transparent 1px);
      background-size: 72px 72px;
      mask-image: linear-gradient(180deg, rgba(0,0,0,.65), rgba(0,0,0,.08));
    }
    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background:
        radial-gradient(circle at 18% 32%, rgba(255,255,255,.78) 0 1px, transparent 2px),
        radial-gradient(circle at 74% 26%, rgba(255,255,255,.78) 0 1px, transparent 2px),
        radial-gradient(circle at 42% 72%, rgba(255,255,255,.64) 0 1px, transparent 2px);
      background-size: 180px 180px, 220px 220px, 260px 260px;
      opacity: .75;
    }

    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }
    button { font: inherit; }

    .shell { width: min(1180px, calc(100% - 44px)); margin: 0 auto; }
    .glass {
      background: linear-gradient(145deg, var(--paper-strong), rgba(255, 239, 247, .70));
      border: 1px solid rgba(255,255,255,.74);
      box-shadow: var(--shadow);
      backdrop-filter: blur(22px) saturate(1.18);
      -webkit-backdrop-filter: blur(22px) saturate(1.18);
    }
    .section { padding: clamp(78px, 9vw, 126px) 0; scroll-margin-top: 92px; }

    .nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 243, 248, .78);
      border-bottom: 1px solid rgba(255,255,255,.72);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }
    .nav-inner {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
      color: var(--rose-dark);
      font-weight: 950;
      white-space: nowrap;
    }
    .brand-mark {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #fff, #ffcfe0 74%);
      color: var(--rose);
      box-shadow: var(--soft);
    }
    .links {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      flex-wrap: wrap;
    }
    .links a {
      min-height: 34px;
      padding: 0 12px;
      border-radius: 999px;
      color: #765765;
      font-size: 13px;
      font-weight: 850;
    }
    .links a:hover { background: rgba(255,255,255,.74); color: var(--rose); }

    .pill {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      max-width: 100%;
      min-height: 34px;
      padding: 0 14px;
      border-radius: 999px;
      background: linear-gradient(135deg, rgba(255,255,255,.82), rgba(255, 205, 224, .48));
      border: 1px solid var(--line);
      color: var(--rose);
      font-size: 12.5px;
      font-weight: 950;
      letter-spacing: .35px;
    }
    .pill::before {
      content: "";
      width: 8px;
      height: 8px;
      margin-right: 8px;
      border-radius: 50%;
      background: var(--pink);
      box-shadow: 0 0 0 4px rgba(244,111,162,.16);
    }

    .hero {
      min-height: calc(100vh - 72px);
      display: grid;
      align-items: center;
      padding: 34px 0 26px;
    }
    .hero-copy {
      position: relative;
      overflow: hidden;
      display: grid;
      align-content: center;
      justify-items: center;
      min-height: min(720px, calc(100vh - 128px));
      border-radius: var(--radius);
      padding: clamp(34px, 7vw, 86px);
      text-align: center;
    }
    .hero-copy::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(255,246,251,.70), rgba(255,243,248,.78)),
        url("新无暖-assets/underwater.png") center/cover;
      opacity: .94;
      pointer-events: none;
    }
    .hero-copy::after {
      content: "CASSIE";
      position: absolute;
      left: 50%;
      bottom: -62px;
      transform: translateX(-50%);
      color: rgba(244,111,162,.12);
      font-size: clamp(88px, 13vw, 188px);
      font-weight: 1000;
      letter-spacing: 2px;
      pointer-events: none;
    }
    .hero h1 {
      position: relative;
      z-index: 1;
      margin: 22px 0 18px;
      font-family: var(--serif);
      font-size: clamp(32px, 4.8vw, 58px);
      line-height: 1.03;
      letter-spacing: 0;
    }
    .hero h1 span { display: block; }
    .hero h1 .accent {
      color: transparent;
      background: linear-gradient(105deg, var(--pink), #cf68bd 52%, #6fcfee);
      -webkit-background-clip: text;
      background-clip: text;
    }
    .role {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 6px;
      margin-bottom: 24px;
      justify-items: center;
    }
    .role strong { font-size: clamp(24px, 2.8vw, 34px); line-height: 1.22; }
    .role span { color: var(--rose); font-weight: 900; }
    .profile-line {
      position: relative;
      z-index: 1;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin: 0 0 26px;
      padding: 0;
      list-style: none;
    }
    .profile-line li {
      padding: 9px 13px;
      border-radius: 999px;
      background: rgba(255,255,255,.68);
      border: 1px solid var(--line);
      color: var(--rose);
      font-size: 13px;
      font-weight: 900;
      box-shadow: 0 12px 28px -22px rgba(142, 42, 84, .46);
    }
    .manifesto {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 14px;
      max-width: 650px;
      margin: 0;
      color: #463944;
      font-size: clamp(16px, 1.5vw, 19px);
      line-height: 1.86;
    }
    .manifesto b { color: var(--rose-dark); }
    .match-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      width: min(880px, 100%);
      margin: 2px 0 24px;
    }
    .match-card {
      display: grid;
      gap: 6px;
      min-height: 98px;
      padding: 16px 18px;
      border-radius: 22px;
      background: rgba(255,255,255,.62);
      border: 1px solid var(--line);
      box-shadow: 0 16px 36px -28px rgba(142, 42, 84, .46);
      text-align: left;
    }
    .match-card b {
      color: var(--rose);
      font-size: 13px;
      letter-spacing: .3px;
    }
    .match-card span {
      color: #443843;
      font-size: 14px;
      line-height: 1.55;
      font-weight: 800;
    }
    .scroll-note {
      position: relative;
      z-index: 1;
      display: inline-grid;
      gap: 5px;
      width: fit-content;
      margin-top: 32px;
      padding: 14px 18px;
      border-radius: 999px;
      background: rgba(255,255,255,.62);
      border: 1px solid var(--line);
      color: var(--rose);
      font-size: 13px;
      font-weight: 900;
    }
    .hero-visual {
      display: none;
      position: relative;
      min-height: 620px;
      overflow: hidden;
      border-radius: var(--radius);
      background: #12225c;
      box-shadow: var(--shadow);
    }
    .hero-visual img {
      width: 100%;
      height: 100%;
      min-height: 620px;
      object-fit: cover;
      object-position: 45% center;
      filter: saturate(1.06) contrast(1.03);
    }
    .hero-visual::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(255, 243, 248, .10), transparent 38%),
        linear-gradient(180deg, transparent 55%, rgba(255, 192, 218, .26));
      pointer-events: none;
    }
    .floating-caption {
      position: absolute;
      left: 22px;
      right: 22px;
      bottom: 22px;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      padding: 13px 16px;
      border-radius: 999px;
      color: #fff;
      background: rgba(53, 36, 75, .42);
      border: 1px solid rgba(255,255,255,.34);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-weight: 900;
      font-size: 13px;
    }

    .section-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 28px;
      margin-bottom: 34px;
    }
    .section-head h2 {
      margin: 14px 0 0;
      font-family: var(--serif);
      font-size: clamp(34px, 4.4vw, 58px);
      line-height: 1.08;
      letter-spacing: 0;
    }
    .section-head p {
      max-width: 480px;
      margin: 0;
      color: var(--muted);
      font-size: 15.5px;
      text-align: right;
    }

    .why-grid {
      display: grid;
      grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
      gap: 24px;
      align-items: stretch;
    }
    .essay-card {
      border-radius: var(--radius);
      padding: clamp(26px, 3.8vw, 44px);
      display: grid;
      align-content: center;
    }
    .essay-card p {
      margin: 0 0 18px;
      color: #463944;
      font-size: clamp(17px, 1.8vw, 22px);
      line-height: 1.9;
      font-weight: 650;
    }
    .essay-card p:last-child { margin-bottom: 0; }
    .essay-card b { color: var(--rose); }
    .why-proof {
      display: grid;
      gap: 16px;
    }
    .proof-card {
      display: grid;
      gap: 12px;
      min-height: 170px;
      padding: 22px;
      border-radius: 24px;
      background: rgba(255,255,255,.72);
      border: 1px solid var(--line);
      box-shadow: var(--soft);
    }
    .proof-card strong { color: var(--rose-dark); font-size: 20px; line-height: 1.25; }
    .proof-card p { margin: 0; color: #574750; font-size: 14.5px; }
    .proof-card img {
      width: 100%;
      height: 170px;
      max-height: 170px;
      object-fit: cover;
      object-position: left top;
      border-radius: 16px;
      background: #fff;
      border: 1px solid rgba(0,0,0,.05);
    }
    .proof-card.visual {
      min-height: 250px;
      overflow: hidden;
      padding: 0;
      background: #fff;
    }
    .proof-card.visual img {
      height: 100%;
      max-height: none;
      object-fit: cover;
      object-position: center 40%;
      border: 0;
      border-radius: 24px;
      opacity: .92;
    }
    .observations {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 16px;
      margin-top: 24px;
    }
    .ob-card {
      min-height: 190px;
      border-radius: 24px;
      padding: 22px;
      background: rgba(255,255,255,.70);
      border: 1px solid var(--line);
      box-shadow: var(--soft);
    }
    .ob-card strong {
      display: block;
      margin-bottom: 10px;
      color: var(--rose);
      font-size: 13px;
      letter-spacing: .6px;
      text-transform: uppercase;
    }
    .ob-card p { margin: 0; color: #463944; font-size: 15px; line-height: 1.8; }

    .method-grid {
      display: grid;
      grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
      gap: 24px;
      align-items: stretch;
    }
    .loop-card {
      border-radius: var(--radius);
      padding: 28px;
      overflow: hidden;
    }
    .loop-flow {
      display: grid;
      gap: 12px;
      margin-top: 18px;
    }
    .loop-step {
      display: grid;
      grid-template-columns: 46px minmax(0,1fr);
      gap: 13px;
      align-items: center;
      padding: 14px;
      border-radius: 18px;
      background: rgba(255,255,255,.68);
      border: 1px solid var(--line);
    }
    .loop-step b {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border-radius: 16px;
      color: #fff;
      background: linear-gradient(135deg, var(--pink), var(--violet));
      box-shadow: var(--soft);
    }
    .loop-step span { color: #493d46; font-weight: 860; }
    .progress-strip {
      display: grid;
      gap: 14px;
      height: 100%;
      max-height: 650px;
      overflow-y: auto;
      overflow-x: hidden;
      scroll-snap-type: y mandatory;
      padding: 4px 10px 4px 4px;
    }
    .progress-strip::-webkit-scrollbar { width: 8px; }
    .progress-strip::-webkit-scrollbar-thumb {
      background: rgba(203, 78, 130, .28);
      border-radius: 999px;
    }
    .progress-card {
      position: relative;
      scroll-snap-align: start;
      overflow: hidden;
      border-radius: 26px;
      background: rgba(255,255,255,.72);
      border: 1px solid var(--line);
      box-shadow: var(--soft);
      display: grid;
      grid-template-columns: 188px minmax(0, 1fr);
      min-height: 176px;
    }
    .progress-card img {
      width: 100%;
      height: 100%;
      min-height: 176px;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .progress-card:nth-child(1) img { object-position: center 42%; }
    .progress-card:nth-child(2) img { object-position: center 28%; }
    .progress-card:nth-child(3) img { object-position: center 28%; }
    .progress-card:nth-child(4) img { object-position: center 36%; }
    .progress-body {
      display: grid;
      gap: 10px;
      padding: 20px;
    }
    .progress-body strong {
      color: var(--rose-dark);
      font-size: 20px;
      line-height: 1.25;
    }
    .progress-body p {
      margin: 0;
      color: #574750;
      font-size: 14.5px;
      line-height: 1.78;
    }
    .progress-index {
      position: absolute;
      left: 16px;
      top: 16px;
      display: grid;
      place-items: center;
      min-width: 46px;
      height: 34px;
      padding: 0 12px;
      border-radius: 999px;
      color: var(--rose);
      background: rgba(255,255,255,.78);
      border: 1px solid var(--line);
      font-weight: 950;
    }

    .evidence-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 18px;
    }
    .evidence-card {
      position: relative;
      overflow: hidden;
      min-height: 310px;
      border-radius: var(--radius);
      padding: 24px;
    }
    .evidence-card.featured { grid-column: 1 / -1; }
    .evidence-card h3 { margin: 12px 0 10px; font-size: 25px; line-height: 1.2; }
    .evidence-card p { margin: 0; color: #574750; font-size: 14.5px; }
    .work-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 0 0 14px;
      color: var(--rose);
      font-size: 12.5px;
      font-weight: 900;
    }
    .work-list {
      display: grid;
      gap: 9px;
      margin: 16px 0 0;
      padding: 0;
      list-style: none;
    }
    .work-list li {
      position: relative;
      padding-left: 18px;
      color: #4f4147;
      font-size: 14px;
      line-height: 1.7;
    }
    .work-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 10px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--pink);
      box-shadow: 0 0 0 4px rgba(244,111,162,.14);
    }
    .thinking {
      margin-top: 16px;
      padding: 14px 16px;
      border-radius: 18px;
      background: rgba(255,255,255,.66);
      border: 1px solid var(--line);
      color: #574750;
      font-size: 14px;
      line-height: 1.7;
    }
    .thinking b { color: var(--rose); }
    .metrics {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
    }
    .metrics span {
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(255,255,255,.72);
      border: 1px solid var(--line);
      color: var(--rose);
      font-weight: 900;
      font-size: 13px;
    }
    .case-study {
      margin-top: 18px;
      padding: 18px;
      border-radius: 24px;
      background: rgba(255,255,255,.66);
      border: 1px solid var(--line);
    }
    .case-study h4 {
      margin: 0 0 10px;
      color: var(--rose-dark);
      font-size: 18px;
      line-height: 1.35;
    }
    .case-study p {
      margin: 0;
      color: #51424b;
      font-size: 14.5px;
      line-height: 1.78;
    }
    .case-flow {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 16px;
    }
    .case-shot {
      overflow: hidden;
      border-radius: 20px;
      background: rgba(255,255,255,.74);
      border: 1px solid var(--line);
      box-shadow: 0 18px 36px -30px rgba(142,42,84,.46);
    }
    .case-shot img {
      width: 100%;
      height: 230px;
      object-fit: cover;
      object-position: center 64%;
      display: block;
      background: #fff;
    }
    .case-shot:nth-child(1) img { object-position: center 62%; }
    .case-shot:nth-child(2) img { object-position: center 65%; }
    .case-shot:nth-child(3) img { object-position: center 68%; }
    .case-shot span {
      display: block;
      padding: 10px 12px 12px;
      color: var(--rose-dark);
      font-size: 13px;
      font-weight: 950;
      line-height: 1.45;
    }

    .support-timeline {
      position: relative;
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      align-items: stretch;
      padding-top: 26px;
    }
    .support-timeline::before {
      content: "";
      position: absolute;
      left: 9%;
      right: 9%;
      top: 12px;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(203,78,130,.32), transparent);
    }
    .support-timeline .evidence-card {
      min-height: 0;
      padding: 22px;
    }
    .support-timeline .evidence-card::before {
      content: "";
      position: absolute;
      left: 34px;
      top: -20px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--pink);
      box-shadow: 0 0 0 7px rgba(244,111,162,.16);
    }

    .notes-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .note-card {
      position: relative;
      display: grid;
      grid-template-columns: 260px minmax(0,1fr);
      overflow: hidden;
      min-height: 320px;
      border-radius: var(--radius);
    }
    .note-stack {
      display: contents;
      gap: 18px;
    }
    .note-card img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .note-card:nth-child(1) img { object-position: center 35%; }
    .note-stack .note-card > img { object-position: center 30%; }
    .note-body { padding: 22px; }
    .note-body h3 { margin: 0 0 12px; font-size: 23px; line-height: 1.24; }
    .note-body p { margin: 0 0 14px; color: #574750; font-size: 14.5px; }
    .comment-proof {
      display: grid;
      gap: 10px;
      margin-top: 14px;
    }
    .comment-proof img {
      width: 100%;
      height: 210px;
      max-height: none;
      object-fit: cover;
      object-position: left top;
      border-radius: 16px;
      background: #fff;
      border: 1px solid rgba(0,0,0,.05);
    }

    .team-grid {
      display: grid;
      grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr);
      gap: 24px;
    }
    .belief {
      border-radius: var(--radius);
      padding: 28px;
    }
    .belief h3 { margin: 0 0 16px; font-size: 28px; }
